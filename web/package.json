{
  "name": "file-indexer-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "//": "The start script args are duplicated in the Dockerfile CMD (which invokes node_modules/srvx/bin/srvx.mjs directly; no npm in the runtime image). Keep both in sync.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "srvx serve --prod --dir=. --static=dist/client --entry=dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "srvx": "^0.11.21"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
