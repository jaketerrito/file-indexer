{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[A-Z_]+_VERSION: \"?(?<currentValue>[^\"\\s]+)\"?\\s*",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+version: \"?(?<currentValue>[^\"\\s]+)\"?\\s*"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/deploy/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    }
  ]
}
